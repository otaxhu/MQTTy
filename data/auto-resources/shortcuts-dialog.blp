using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }

    Adw.ShortcutsItem {
      title: _("Change to publish view");
      action-name: "win.set-publish-view";
    }

    Adw.ShortcutsItem {
      title: _("Change to subscriptions view");
      action-name: "win.set-subscriptions-view";
    }
  }

  Adw.ShortcutsSection {
    title: _("Publish view");

    Adw.ShortcutsItem {
      title: _("New tab");
      action-name: "win.publish-new-tab";
    }

    Adw.ShortcutsItem {
      title: _("Delete current tab");
      action-name: "win.publish-delete-tab";
    }

    Adw.ShortcutsItem {
      title: _("Send message in current tab");
      action-name: "win.publish-send";
    }
  }
}
